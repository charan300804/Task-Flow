    },
    {
      "title": "Queue Depths",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "expr": "taskflow_queue_depth", "legendFormat": "{{queue_name}}" }]
    }
